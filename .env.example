RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=choose_a_separate_webhook_secret
APP_ENV=development
LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_TOKEN=
OTEL_TRACING_ENABLED=false
OTEL_SERVICE_NAME=cinema-api
OTEL_TRACE_SAMPLE_RATIO=0.1
# Bundled local Jaeger; enable tracing above to export HTTP spans.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# Optional OTLP headers, for example: Authorization=Bearer%20token
OTEL_EXPORTER_OTLP_HEADERS=
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
TLS_CERT_FILE=
TLS_KEY_FILE=
REQUIRE_HTTPS=false
CORS_ALLOWED_ORIGINS=
HSTS_MAX_AGE=8760h
# Comma-separated proxy networks; leave empty when serving directly.
TRUSTED_PROXY_CIDRS=
PUBLIC_BASE_URL=http://localhost:8080
TICKET_SIGNING_SECRET=replace-with-at-least-32-random-characters
SCANNER_API_KEY=replace-with-at-least-24-random-characters
VERIFICATION_SECRET=replace-with-a-separate-32-character-random-secret
# Comma-separated existing or future accounts that receive the bootstrap admin role.
ADMIN_EMAILS=

# Local development logs notification contents. Set false in production.
NOTIFICATION_LOG_ONLY=true
SMTP_ADDR=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMS_WEBHOOK_URL=
SMS_API_TOKEN=

# Optional Google OpenID Connect login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Redis authentication, connection pool, and optional TLS/mTLS.
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2
REDIS_TLS_ENABLED=false
REDIS_TLS_SERVER_NAME=
REDIS_TLS_CA_FILE=
REDIS_TLS_CERT_FILE=
REDIS_TLS_KEY_FILE=
